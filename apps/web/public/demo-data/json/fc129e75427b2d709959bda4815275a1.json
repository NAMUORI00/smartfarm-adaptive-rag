_stage":null},{"source_id":"farm-wasabi-a:telemetry:zone-a:air_temperature_c","title":"고추냉이 고설베드 A동 · 1구역 최신 재배실 온도","excerpt":"1구역 (zone-a), 2026-10-09T11:41:20+00:00 관측값: 65 °C (상태: 확인 필요). 센서 품질 의심: 이 값은 실제 환경으로 해석하지 말고 판단 근거에서 제외하세요.","source_kind":"private_simulation","observed_at":"2026-10-09T11:41:20Z","relevance":"medium","document_id":null,"chunk_id":null,"score":null,"location":"telemetry snapshot","version":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null},{"source_id":"farm-wasabi-a:telemetry:zone-a:irrigation_flow_l_min","title":"고추냉이 고설베드 A동 · 1구역 최신 관수 유량","excerpt":"1구역 (zone-a), 2026-10-09T11:41:20+00:00 관측값: 0 L/min (상태: 기준 범위).","source_kind":"private_simulation","observed_at":"2026-10-09T11:41:20Z","relevance":"medium","document_id":null,"chunk_id":null,"score":null,"location":"telemetry snapshot","version":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null},{"source_id":"farm-wasabi-a:telemetry:zone-a:substrate_temperature_c","title":"고추냉이 고설베드 A동 · 1구역 최신 배지 온도","excerpt":"1구역 (zone-a), 2026-10-09T11:41:20+00:00 관측값: 18 °C (상태: 기준 범위).","source_kind":"private_simulation","observed_at":"2026-10-09T11:41:20Z","relevance":"medium","document_id":null,"chunk_id":null,"score":null,"location":"telemetry snapshot","version":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null},{"source_id":"private:farm-wasabi-a:operations-sop:v1","title":"고추냉이 A동 근권·관수 대응 SOP","excerpt":"근권 온도 경보에서는 냉각기 출력, 공급수 온도, 관수 유량과 최근 작업을 순서대로 확인한다. 펌프가 켜져 있지만 유량과 압력이 함께 감소하면 관수 라인과 밸브를 우선 점검한다. 공급 EC가 시범 recipe를 벗어나면 배액 EC, 원수, 센서 교정 기록을 함께 확인한다. 센서 하나만 급격하게 상승하고 인접 지표와 설비 전력이 정상이라면 장치 제어보다 센서 점검 작업을 우선한다. 모든 설정 변경은 제안과 별도 책임자 승인 후 시뮬레이터에 적용한다.","source_kind":"private_knowledge","observed_at":null,"relevance":"high","document_id":"private:farm-wasabi-a:operations-sop:v1","chunk_id":"private:farm-wasabi-a:operations-sop:v1:chunk-001","score":0.016393,"location":"본문 구간 1","version":"v1","issuer":"고추냉이 고설베드 A동","published_year":null,"document_type":"농장 운영 SOP","source_url":null,"summary":"근권 고온, 관수 유량 저하, EC 편차와 센서 이상을 구분해 점검하는 시뮬레이션 농장 SOP입니다.","source_locator":null,"crop":"wasabi","cultivation_system":"perlite_substrate","evidence_class":"farm_sop","growth_stage":"leaf_production"},{"source_id":"synthetic:wasabi:simulation-policy:v1","title":"고추냉이 시뮬레이터 운영 정책","excerpt":"경보 지속시간, 히스테리시스, 장치 반응 속도는 농학 문헌값이 아니라 반복 가능한 데모를 위한 시뮬레이터 정책이다. 작물 위험과 센서 이상은 별도 경보로 기록하며, 센서 이상이 우선 판정되면 냉각·관수·양액 장치 제어를 추천하지 않는다.","source_kind":"synthetic_demo","observed_at":null,"relevance":"medium","document_id":"synthetic:wasabi:simulation-policy:v1","chunk_id":"synthetic:wasabi:simulation-policy:v1:chunk-001","score":0.014095,"location":"본문 구간 1","version":"v1","issuer":"로컬 검증 환경","published_year":null,"document_type":"시뮬레이터 정책","source_url":null,"summary":"경보 지속시간과 장치 반응을 재현하기 위한 합성 운영 규칙입니다.","source_locator":null,"crop":"wasabi","cultivation_system":"perlite_substrate","evidence_class":"simulated","growth_stage":"leaf_production"},{"source_id":"public:wasabi:nongsaro-perlite-field-case:2026","title":"고추냉이 펄라이트 고설베드 현장 운영 사례","excerpt":"이 자료는 국내 펄라이트 고설베드 양액재배로 고추냉이 잎과 잎자루를 생산하는 현장 사례다. 통합환경 제어에는 온도, 상대습도, 전기전도도, pH, 이산화탄소 센서와 천·측창, 보온커튼, 유동·환기팬, LED, 양액 설비가 사용된다. 현장 운영값은 양액 EC 1.8~2.4 dS/m, pH 6.2이며, 겨울철 관수 사례는 하루 3회 각 1~2분이다. 이 값은 특정 농장의 펄라이트 잎 생산 recipe이므로 다른 품종·배지·생산 목표에 보편적 최적값으로 적용하지 않는다. 정식 후 약 두 달부터 잎 수확이 가능하다는 현장 설명도 같은 적용 범위를 갖는다.","source_kind":"public_knowledge","observed_at":null,"relevance":"medium","document_id":"public:wasabi:nongsaro-perlite-field-case:2026","chunk_id":"public:wasabi:nongsaro-perlite-field-case:2026:chunk-001","score":0.013807,"location":"본문 구간 1","version":"2026-field-reference","issuer":"농사로 농업기술포털","published_year":2026,"document_type":"현장 운영 사례","source_url":"https://www.nongsaro.go.kr/portal/ps/psx/psxs/newsMainView.ps?menuId=PS65437&newsSeqNo=133743","summary":"국내 펄라이트 고설베드에서 고추냉이 잎을 생산하는 스마트팜의 환경·양액 운영 사례입니다.","source_locator":null,"crop":"wasabi","cultivation_system":"perlite_substrate","evidence_class":"official_agronomy","growth_stage":"leaf_production"},{"source_id":"official_agronomy_kr_a3be9a6d903a_p39_39","title":"농촌진흥청 농사로 재배 기술 자료 · 39쪽","excerpt":"40 (1) 연부병(무름병) ○ 병징 엽맥이 흑갈색으로 되고 잎이 황변하면서 고사한다. 엽병은 수침상(水浸狀)의 반 점이 생겨 점차 흑갈색으로 변하면서 물러져 부패된다. 근경도 물러지고 회백색을 띠면서 악취를 풍긴다. 고온기 이후에 많이 발생하는데, 가을에 찬바람이 불면 근경 의 부패가 일부 멈추고 부패되지 않은 근경의 일부가 다시 생육하는 경우도 있다. ○ 병원균 병원균은 토양에 서식하는 세균(Erwinia aroideae Holland)의 일종이다. 이 균의 발육온도는 0~37℃인데, 최적온도는 34℃이며, 중성이나 알칼리 토양에서는 생육 이 좋고 토양이 건조하면 약해진다. ○ 전염 방법 1차 전염 경로는 토양 내 병든 식물체나 잡초의 뿌리 근처에서 월동한 세균이 식물 체의 자연적 개구(開口)나 토양곤충에 의한 상처를 통해 들어가 병을 일으킨다. 2 차 전염 경로는 관개수나 빗물을 통해서 전염되는데, 균이 식물체의 표피를 뚫고 직접 침입하지는 못하므로 식물체에 상처가 생기지 않도록 해야 한다.","source_kind":"public_knowledge","observed_at":null,"relevance":"medium","document_id":"official_agronomy_kr_a3be9a6d903a_p39_39","chunk_id":"official_agronomy_kr_a3be9a6d903a_p39_39:chunk-001","score":0.013547,"location":"39쪽","version":"wasabi-neural-bge-v4","issuer":"농촌진흥청 농사로","published_year":null,"document_type":"PDF 문서","source_url":"https://www.nongsaro.go.kr/portal/ps/psb/psbx/cropsEbookWonFileDownload.do?ebookCode=57&cropsEbookFileNo=00001&pageNumber=34","summary":"(1) 연부병(무름병) 엽맥이 흑갈색으로 되고 잎이 황변하면서 고사한다.","source_locator":"39쪽","crop":null,"cultivation_system":null,"evidence_class":"official_agronomy","growth_stage":"rhizome_production"},{"source_id":"public:wasabi:jstage-root-zone-temperature:2009","title":"고추냉이 순환수경의 공기·양액 온도 실험","excerpt":"인공광 순환수경 시험에서 명기 공기온도 16, 20, 25°C와 양액온도 13°C를 비교했을 때 공기온도가 높아질수록 처리 90일 후 건물중이 감소했다. 별도 시험에서 양액온도 20°C 상시 순환은 13°C보다 생육이 작았지만, 20°C 간헐 급액으로 뿌리가 공기층에서 산소를 흡수하게 한 처리는 13°C와 비슷한 생육을 보였다. 이는 근권 온도와 산소 공급을 함께 해석해야 한다는 근거다. 다만 EC 0.5 dS/m, 인공광, 특정 시험 조건의 결과이므로 국내 펄라이트 잎 생산의 절대 온도 임계값으로 직접 전용하지 않는다.","source_kind":"public_knowledge","observed_at":null,"relevance":"medium","document_id":"public:wasabi:jstage-root-zone-temperature:2009","chunk_id":"public:wasabi:jstage-root-zone-temperature:2009:chunk-001","score":0.01316,"location":"본문 구간 1","version":"peer-reviewed-2009","issuer":"일본 식물환경공학회","published_year":2009,"document_type":"동료심사 논문","source_url":"https://www.jstage.jst.go.jp/article/shita/21/4/21_4_175/_pdf/-char/en","summary":"인공광 순환수경에서 공기와 양액 온도가 고추냉이 생육에 미치는 영향을 비교한 실험입니다.","source_locator":null,"crop":"wasabi","cultivation_system":"hydroponic","evidence_class":"peer_reviewed","growth_stage":"vegetative_growth"}],"ignored_source_ids":[],"routing":{"mode":"qact","qact_profile_id":"wasabi-neural-bge-v4","qact_profile_state":"valid","retrieval_path":["dense","sparse","graph"],"graph_gate":{"considered":true,"enabled":true,"reason":"source_span_verified_graph_relation_passed","threshold":0.6,"reliability":0.72,"harm_suppressed":false},"reasons":["Dense retrieval remains the baseline.","Research candidate channels; final family selected after source-backed Graph evidence."],"query_segment_id":"research-candidate","channel_weights":{"dense":0.3,"sparse":0.3,"graph":0.4},"graph_reliability_threshold":0.6,"route_reason":"source_backed_adaptive_fusion","release_checksum":"8933d9471cf5d980f83b8c308702d1fc7de5ee76ed763374bab6ba0cf6e1e103","snapshot_hashes":{"corpus":"4906d3376c5449262354b2a9cf26d5180b1a2af3507de883a10eec0785362aea","embedding":"c90cb56335f9a4587b94fc4d30f09855cc165398bd3e775cd0db620b61bbe671","graph":"4c756d670b8c130864b4b9ca1a7de2a7947b062c37a6ed68c9a41f78afdb5cbf"}},"execution":{"provider":"local-deterministic","requested_model":null,"requested_service_tier":null,"model":null,"service_tier":null,"remote_llm_used":false,"privacy_route":"local_only","fallback_reason":null},"retrieval":{"run_id":"retr