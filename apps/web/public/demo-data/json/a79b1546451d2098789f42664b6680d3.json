":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null},{"source_id":"farm-wasabi-a:telemetry:zone-a:air_temperature_c","title":"고추냉이 고설베드 A동 · 1구역 최신 재배실 온도","excerpt":"1구역 (zone-a), 2026-10-09T11:48:13+00:00 관측값: 65 °C (상태: 확인 필요). 센서 품질 의심: 이 값은 실제 환경으로 해석하지 말고 판단 근거에서 제외하세요.","source_kind":"private_simulation","observed_at":"2026-10-09T11:48:13Z","relevance":"medium","document_id":null,"chunk_id":null,"score":null,"location":"telemetry snapshot","version":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null},{"source_id":"farm-wasabi-a:telemetry:zone-a:irrigation_flow_l_min","title":"고추냉이 고설베드 A동 · 1구역 최신 관수 유량","excerpt":"1구역 (zone-a), 2026-10-09T11:48:13+00:00 관측값: 0 L/min (상태: 기준 범위).","source_kind":"private_simulation","observed_at":"2026-10-09T11:48:13Z","relevance":"medium","document_id":null,"chunk_id":null,"score":null,"location":"telemetry snapshot","version":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null},{"source_id":"farm-wasabi-a:telemetry:zone-a:substrate_temperature_c","title":"고추냉이 고설베드 A동 · 1구역 최신 배지 온도","excerpt":"1구역 (zone-a), 2026-10-09T11:48:13+00:00 관측값: 18 °C (상태: 기준 범위).","source_kind":"private_simulation","observed_at":"2026-10-09T11:48:13Z","relevance":"medium","document_id":null,"chunk_id":null,"score":null,"location":"telemetry snapshot","version":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null},{"source_id":"private:farm-wasabi-a:operations-sop:v1","title":"고추냉이 A동 근권·관수 대응 SOP","excerpt":"근권 온도 경보에서는 냉각기 출력, 공급수 온도, 관수 유량과 최근 작업을 순서대로 확인한다. 펌프가 켜져 있지만 유량과 압력이 함께 감소하면 관수 라인과 밸브를 우선 점검한다. 공급 EC가 시범 recipe를 벗어나면 배액 EC, 원수, 센서 교정 기록을 함께 확인한다. 센서 하나만 급격하게 상승하고 인접 지표와 설비 전력이 정상이라면 장치 제어보다 센서 점검 작업을 우선한다. 모든 설정 변경은 제안과 별도 책임자 승인 후 시뮬레이터에 적용한다.","source_kind":"private_knowledge","observed_at":null,"relevance":"high","document_id":"private:farm-wasabi-a:operations-sop:v1","chunk_id":"private:farm-wasabi-a:operations-sop:v1:chunk-001","score":0.016393,"location":"본문 구간 1","version":"v1","issuer":"고추냉이 고설베드 A동","published_year":null,"document_type":"농장 운영 SOP","source_url":null,"summary":"근권 고온, 관수 유량 저하, EC 편차와 센서 이상을 구분해 점검하는 시뮬레이션 농장 SOP입니다.","source_locator":null,"crop":"wasabi","cultivation_system":"perlite_substrate","evidence_class":"farm_sop","growth_stage":"leaf_production"},{"source_id":"public:wasabi:nongsaro-perlite-field-case:2026","title":"고추냉이 펄라이트 고설베드 현장 운영 사례","excerpt":"이 자료는 국내 펄라이트 고설베드 양액재배로 고추냉이 잎과 잎자루를 생산하는 현장 사례다. 통합환경 제어에는 온도, 상대습도, 전기전도도, pH, 이산화탄소 센서와 천·측창, 보온커튼, 유동·환기팬, LED, 양액 설비가 사용된다. 현장 운영값은 양액 EC 1.8~2.4 dS/m, pH 6.2이며, 겨울철 관수 사례는 하루 3회 각 1~2분이다. 이 값은 특정 농장의 펄라이트 잎 생산 recipe이므로 다른 품종·배지·생산 목표에 보편적 최적값으로 적용하지 않는다. 정식 후 약 두 달부터 잎 수확이 가능하다는 현장 설명도 같은 적용 범위를 갖는다.","source_kind":"public_knowledge","observed_at":null,"relevance":"medium","document_id":"public:wasabi:nongsaro-perlite-field-case:2026","chunk_id":"public:wasabi:nongsaro-perlite-field-case:2026:chunk-001","score":0.015152,"location":"본문 구간 1","version":"2026-field-reference","issuer":"농사로 농업기술포털","published_year":2026,"document_type":"현장 운영 사례","source_url":"https://www.nongsaro.go.kr/portal/ps/psx/psxs/newsMainView.ps?menuId=PS65437&newsSeqNo=133743","summary":"국내 펄라이트 고설베드에서 고추냉이 잎을 생산하는 스마트팜의 환경·양액 운영 사례입니다.","source_locator":null,"crop":"wasabi","cultivation_system":"perlite_substrate","evidence_class":"official_agronomy","growth_stage":"leaf_production"},{"source_id":"official_agronomy_kr_a3be9a6d903a_p37_37","title":"농촌진흥청 농사로 재배 기술 자료 · 37쪽","excerpt":"38 다음 지베렐린 100ppm 수용액(물 1ℓ에 농용 지베렐린 100mg을 녹임)에 담근 후 5℃의 냉장고에 7일간 보관한 다음 파종하면 종자의 휴면이 타파되어 발아율이 높 아지게 된다. 그러나 이듬해 봄에 파종할 종자는 그대로 저장했다가 바로 파종하 면 된다. ○ 상토 준비 및 파종 모판은 폭 1m, 높이 0.2m, 길이 15m 이내로 하여 남북 방향으로 만든다. 상토는 유기물이 많고 고운 모래가 적당하며, 비옥하고 물빠짐이 좋아야 한다. 평당 잘 부 숙된 퇴비 4~5kg과 복합비료 1kg 정도 그리고 소석회 1kg을 시비하는데, 화학비 료는 토양의 비옥도에 따라 적당히 가감한다. 파종은 가을뿌림(9월 하순~10월 상 순) 또는 봄뿌림(3월 상순~4월 중순)을 할 수 있는데, 보통은 가을뿌림을 한다. 파 종량은 평당 36㎖(10a당 1.8ℓ) 소요되는데, 줄 사이 6cm, 포기 사이 4cm로 3~4알 씩 점뿌림하거나 줄 사이 6~10cm 간격으로 줄뿌림한다. ○ 파종 후 관리 파종 후 너무 과습하거나 건조하지 않게 묘상을 관리한다.","source_kind":"public_knowledge","observed_at":null,"relevance":"medium","document_id":"official_agronomy_kr_a3be9a6d903a_p37_37","chunk_id":"official_agronomy_kr_a3be9a6d903a_p37_37:chunk-001","score":0.013909,"location":"37쪽","version":"wasabi-neural-bge-v4","issuer":"농촌진흥청 농사로","published_year":null,"document_type":"PDF 문서","source_url":"https://www.nongsaro.go.kr/portal/ps/psb/psbx/cropsEbookWonFileDownload.do?ebookCode=57&cropsEbookFileNo=00001&pageNumber=34","summary":"다음 지베렐린 100ppm 수용액(물 1ℓ에 농용 지베렐린 100mg을 녹임)에 담근 후 5℃의 냉장고에 7일간 보관한 다음 파종하면 종자의 휴면이 타파되어 발아율이 높","source_locator":"37쪽","crop":null,"cultivation_system":null,"evidence_class":"official_agronomy","growth_stage":null},{"source_id":"official_agronomy_kr_a3be9a6d903a_p38_38","title":"고추냉이 재배 기술 자료 · 38쪽","excerpt":"제2장 고추냉이 39 (2) 시비 기비로는 유기질 비료나 완효성 비료를 포장 전면에 시비하고 경운하여 정식하며, 복비(14-14-14)는 봄·가을에 생육을 보아가며 추비한다. 밭재배와 같은 단기재배 에서는 유기질 거름을 많이 주어 단기간에 생장하도록 해야 한다. 시비량은 보통 10a당 퇴비 2,000kg, 계분 150kg, 소석회 100kg, 용과린 40kg, 유기질 비료 90kg을 시비하고 봄·가을로 복비를 40kg 추비한다. (3) 정식 후 관리 정식 후 왕겨나 짚 등을 이랑 사이에 덮거나 비닐멀칭을 하여 건조해지거나 토양 이 단단해지는 것을 막는다. 생육최성기에는 적당한 차광도 필요하다. 차광은 원 래 뽕나무, 감나무 등과 같은 수목을 이용하면 차광망보다 온도가 1.5~2.5℃ 정도 내려간다. 지온은 19℃ 내외가 좋고 기온이 25℃ 이상에서는 고온피해를 받는다. 인공차광을 해야 할 시기인 봄과 가을에는 50%, 여름철에는 70%, 겨울에는 차광 하지 않는다. 차광을 위해 나무를 심고 그 아래에 차광막으로 보충 차광을 하면 기 온상승을 효과적으로 막을 수 있다.","source_kind":"public_knowledge","observed_at":null,"relevance":"medium","document_id":"official_agronomy_kr_a3be9a6d903a_p38_38","chunk_id":"official_agronomy_kr_a3be9a6d903a_p38_38:chunk-001","score":0.013406,"location":"38쪽","version":"wasabi-neural-bge-v4","issuer":"농촌진흥청 농사로","published_year":null,"document_type":"PDF 문서","source_url":"https://www.nongsaro.go.kr/portal/ps/psb/psbx/cropsEbookWonFileDownload.do?ebookCode=57&cropsEbookFileNo=00001&pageNumber=34","summary":"기비로는 유기질 비료나 완효성 비료를 포장 전면에 시비하고 경운하여 정식하며, 복비(14-14-14)는 봄·가을에 생육을 보아가며 추비한다.","source_locator":"38쪽","crop":"wasabi","cultivation_system":null,"evidence_class":"official_agronomy","growth_stage":"rhizome_production"},{"source_id":"synthetic:wasabi:simulation-policy:v1","title":"고추냉이 시뮬레이터 운영 정책","excerpt":"경보 지속시간, 히스테리시스, 장치 반응 속도는 농학 문헌값이 아니라 반복 가능한 데모를 위한 시뮬레이터 정책이다. 작물 위험과 센서 이상은 별도 경보로 기록하며, 센서 이상이 우선 판정되면 냉각·관수·양액 장치 제어를 추천하지 않는다.","source_kind":"synthetic_demo","observed_at":null,"relevance":"medium","document_id":"synthetic:wasabi:simulation-policy:v1","chunk_id":"synthetic:wasabi:simulation-policy:v1:chunk-001","score":0.013375,"location":"본문 구간 1","version":"v1","issuer":"로컬 검증 환경","published_year":null,"document_type":"시뮬레이터 정책","source_url":null,"summary":"경보 지속시간과 장치 반응을 재현하기 위한 합성 운영 규칙입니다.","source_locator":null,"crop":"wasabi","cultivation_system":"perlite_substrate","evidence_class":"simulated","growth_stage":"leaf_production"},{"source_id":"crop-cycle:81a449a2-3607-4d21-aa73-45703659e729","title":"선택한 재배 회차 등록 정보","excerpt":"{\"crop\": \"고추냉이\", \"cultivar\": \"달마\", \"harvest_part\": \"근경\", \"planted_on\": \"2026-08-20\", \"remaining_count\": 24}","source_kind":"private_knowledge","observed_at":null,"relevance":"high","document_id":null,"chunk_id":null,"score":null,"location":"4번 베드 · 1단","version":null,"issuer":null,"published_year":null,"document_type":null,"source_url":null,"summary":null,"source_locator":null,"crop":null,"cultivation_system":null,"evidence_class":null,"growth_stage":null}],"ignored_source_ids":[],"routing":{"mode":"qact","qact_profile_id":"wasabi-neural-b