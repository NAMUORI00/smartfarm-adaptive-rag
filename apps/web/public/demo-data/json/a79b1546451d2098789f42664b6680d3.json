"value_type":"percentage","minimum":0.0,"maximum":100.0,"step":5.0,"mcp_action":"set_side_vent_open_percent"},"zone_id":"zone-a","desired_value":8.0,"reported_value":8.0,"effective_value":8.0,"unit":"%","mode":"scheduled","health":"normal","command_id":null},"device:zone-a:zone-a:shade_curtain":{"key":"zone-a:shade_curtain","target":"shade_curtain","label":"차광 커튼","state":"92% closed","controllable":true,"execution_scope":"simulator_only","capability":{"action":"set_actuator_state","value_type":"percentage","minimum":0.0,"maximum":100.0,"step":5.0,"mcp_action":"set_thermal_curtain_percent"},"zone_id":"zone-a","desired_value":92.0,"reported_value":92.0,"effective_value":92.0,"unit":"%","mode":"scheduled","health":"normal","command_id":null},"device:zone-a:zone-a:air_temperature_sensor_reset":{"key":"zone-a:air_temperature_sensor_reset","target":"air_temperature_sensor_reset","label":"공기 온도 센서","state":"completed","controllable":true,"execution_scope":"simulator_only","capability":{"action":"recalibrate_air_temperature_sensor","value_type":"boolean","minimum":null,"maximum":null,"step":null,"mcp_action":"recalibrate_air_temperature_sensor"},"zone_id":"zone-a","desired_value":true,"reported_value":true,"effective_value":true,"unit":"boolean","mode":"manual","health":"normal","command_id":null},"alerts":[{"id":"farm-wasabi-a:air_temperature_c:sensor-health","occurrence_id":"alert-occurrence-ba8e3e23ebba488b8c5718ec43d02956","severity":"critical","title":"재배실 온도 센서 건전성 경보","message":"온도 센서 값이 물리 허용 범위를 벗어났습니다. 센서, 배선, 통신 상태를 먼저 점검하세요.","status":"active","created_at":"2026-09-28T01:10:33Z","source":"telemetry_rule","alert_kind":"sensor_health","zone_id":"zone-a"},{"id":"farm-wasabi-a:air_temperature_c:data-quality","occurrence_id":"alert-occurrence-80c93049e04c4df4a467ea6e6e4d1b8c","severity":"warning","title":"재배실 온도 센서 건전성 경보","message":"센서 데이터 품질이 운영 판단 기준을 충족하지 않습니다.","status":"active","created_at":"2026-09-28T01:10:20Z","source":"telemetry_rule","alert_kind":"sensor_health","zone_id":"zone-a"}],"control_allowed":true,"origin":"telemetry_service"},"refresh_count":0,"previous_response_id":null,"mode":"full","units":[{"id":"state","depends_on":["origin"],"text":"## 현황\n현재 운영 관측: 근권 온도 18 °C (기준 범위), 재배실 온도 65 °C (센서 품질 의심, 판단에서 제외), 관수 유량 0 L/min (기준 범위), 배지 온도 18 °C (기준 범위).\n\n## 판단\n재배 자료에는 이렇게 나옵니다.\n- 센서 하나만 급격하게 상승하고 인접 지표와 설비 전력이 정상이라면 장치 제어보다 센서 점검 작업을 우선한다. (고추냉이 A동 근권·관수 대응 SOP) [5]\n- 통합환경 제어에는 온도, 상대습도, 전기전도도, pH, 이산화탄소 센서와 천·측창, 보온커튼, 유동·환기팬, LED, 양액 설비가 사용된다. (고추냉이 펄라이트 고설베드 현장 운영 사례) [6]\n\n## 점검 순서\n1. 센서 원시값과 관측 시각을 확인합니다.\n2. 최근 관수·냉각·환기 작업 이력을 대조합니다.\n3. 수치 조치 전 연결된 원문에서 적용 범위를 확인합니다.\n\n## 근거와 한계\n검색된 근거: 고추냉이 A동 근권·관수 대응 SOP (본문 구간 1), 고추냉이 펄라이트 고설베드 현장 운영 사례 (본문 구간 1). 판단의 문장은 원문에서 그대로 옮겼으며, 현재 답변은 검색 결과를 정리한 로컬 요약입니다.","evidence_ids":["farm-wasabi-a:telemetry:zone-a:root_zone_temperature_c","farm-wasabi-a:telemetry:zone-a:air_temperature_c","farm-wasabi-a:telemetry:zone-a:irrigation_flow_l_min","farm-wasabi-a:telemetry:zone-a:substrate_temperature_c","private:farm-wasabi-a:operations-sop:v1","public:wasabi:nongsaro-perlite-field-case:2026","official_agronomy_kr_a3be9a6d903a_p37_37","official_agronomy_kr_a3be9a6d903a_p38_38","synthetic:wasabi:simulation-policy:v1","crop-cycle:81a449a2-3607-4d21-aa73-45703659e729"]},{"id":"action","depends_on":["origin"],"text":"직접 조절은 변경 내용을 확인한 뒤 허용할 수 있습니다.","evidence_ids":["farm-wasabi-a:telemetry:zone-a:root_zone_temperature_c","farm-wasabi-a:telemetry:zone-a:air_temperature_c","farm-wasabi-a:telemetry:zone-a:irrigation_flow_l_min","farm-wasabi-a:telemetry:zone-a:substrate_temperature_c","private:farm-wasabi-a:operations-sop:v1","public:wasabi:nongsaro-perlite-field-case:2026","official_agronomy_kr_a3be9a6d903a_p37_37","official_agronomy_kr_a3be9a6d903a_p38_38","synthetic:wasabi:simulation-policy:v1","crop-cycle:81a449a2-3607-4d21-aa73-45703659e729"]},{"id":"evidence","depends_on":[],"text":"판단에 사용한 자료와 관측을 확인하세요.","evidence_ids":["farm-wasabi-a:telemetry:zone-a:root_zone