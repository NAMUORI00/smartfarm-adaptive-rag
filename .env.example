# Copy to .env for local Compose execution. Never commit real values.
# Local-only service tokens (change them for anything beyond a local demo).
TELEMETRY_PORT=8120
MCP_PORT=8110
TELEMETRY_INTERNAL_TOKEN=change-me-local-telemetry-token
MCP_SERVICE_TOKEN=change-me-local-mcp-token

# Checksum-pinned QACT demo release used by services/api tests and tools.
QACT_PROFILE_PATH=data/qact-profile/demo-release.json
QACT_PROFILE_SHA256=12a6992cd541a97f872d52f558513bca3d3f8c6bdb578de2ac77eb2238dabf9f

# Embedding provider for services/api KnowledgeStore (hash = offline test mode).
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
